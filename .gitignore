# The runtime state a Producer writes and never commits.
.runtime/

# Python bytecode and test caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Editor / OS noise.
.idea/
.vscode/
Thumbs.db
desktop.ini

# The per-project Claude permission mode setup.py writes (mode a or b); machine-local, never committed.
.claude/settings.local.json

# Keys must never be committed — they live outside the repo, but guard any stray copy.
*.env
keys.env

# Atomic-write temp files and single-writer locks of the tool state.
*.tmp
*.lock
