{
  "outputStyle": "Concise",
  "promptSuggestionEnabled": false,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python tools/hooks.py owner-message", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python tools/hooks.py stop-guard", "timeout": 10 }
        ]
      }
    ]
  }
}
